{
  "id": "elfrey-scene-browser",
  "title": "Elfrey Scene Browser",
  "description": "Браузер всех сцен из библиотек установленных модулей — включённых и выключенных, — а также из паков-приключений, паков системы, паков мира и сцен мира: дерево, поиск, фильтры, превью, импорт. / Browse every Scene shipped by installed modules (active or not) and by adventure packs, the system, world compendiums and the world itself: tree, search, filters, previews, import.",
  "version": "0.1.2",
  "authors": [
    {
      "name": "Elfrey",
      "url": "https://github.com/Elfrey"
    }
  ],
  "url": "https://github.com/Elfrey/elfrey-scene-browser",
  "readme": "README.md",
  "bugs": "https://github.com/Elfrey/elfrey-scene-browser/issues",
  "license": "MIT",
  "manifest": "https://github.com/Elfrey/elfrey-scene-browser/releases/latest/download/module.json",
  "download": "https://github.com/Elfrey/elfrey-scene-browser/releases/download/v0.1.2/module.zip",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/elfrey-scene-browser.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "ru",
      "name": "Русский",
      "path": "lang/ru.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "lang"
      ]
    }
  }
}
